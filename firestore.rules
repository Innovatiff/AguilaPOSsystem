rules_version = '2';

// Catálogo Águila · Reglas de Firestore
// ---------------------------------------------------------------------
// Principios:
//  - Entra solo el personal REGISTRADO: una cuenta de Firebase Authentication
//    necesita su ficha staff/{usuario} activa. Las fichas las crea el gerente
//    desde Gestión (y con ellas la cuenta). Una cuenta sin ficha no lee nada,
//    así que el registro de cuentas puede quedar habilitado en Authentication.
//  - El "usuario" es el identificador estable de la persona: su código de
//    empleado (la cuenta detrás es un correo sintético "<código>@<dominio>",
//    con sufijo ".<versión>" si se restableció el NIP) o su correo real.
//    Es lo que va en actualizadoPor y en el historial.
//  - Las reglas hacen cumplir el esquema: nombres de campo exactos, tipos,
//    enumeraciones y rangos. Un campo de más rechaza la escritura.
//  - Todo cambio de precioCentavos exige su entrada en priceHistory dentro
//    del mismo lote (batch), con el precio anterior real y el nuevo.
//  - Nada se borra: productos y personal se desactivan; el historial es inmutable.
//  - Apps: el back office (catálogo, precios, personal, reportes) es solo
//    para administradores; la caja (POS) y la consulta de precios, para todo
//    el personal registrado; la app Catálogo, para quien tenga permiso de
//    catálogo (staff.catalogo). Ese personal edita los datos de un producto
//    pero NUNCA su precio, unidad de venta, clase fiscal ni si está activo:
//    las altas (sin precio) y las bajas las pide en solicitudes/{id} y las
//    resuelve un admin, en el mismo lote que escribe el producto.
//  - Cada colaborador se registra con su correo y un NIP de 6 dígitos único.
//    correos/{correo} = { codigo } deja entrar con correo + NIP; nips/{huella}
//    = { codigo, version } deja entrar solo con el NIP en una caja configurada
//    (la huella es un HMAC del NIP con la clave de secretos/caja, que solo leen
//    los administradores y las cajas que ellos configuran).
//  - eventos/{id}: cada acción de una caja conforme ocurre (movimientos en
//    vivo y el historial de auditoría de cada ticket). Los escribe quien vende,
//    a su nombre; son inmutables y solo los leen los administradores.
//  - recepciones/{id}: la mercancía que llegó (inventario). La registran los
//    administradores y el personal del Catálogo; solo un admin la anula.
//  - pantallas/{huella}: la pantalla del cliente de una caja, para la tableta
//    que la muestra. El id es un HMAC del id de la caja con la clave de caja:
//    solo una caja configurada o un administrador lo pueden calcular. La
//    tableta lo lee sin sesión (un documento, sin listar); la empareja (crea)
//    y la desconecta (borra) un admin; la actualiza quien atiende la caja.
//  - POS: una caja tiene a lo sumo un turno abierto; abrir y cerrar turno se
//    hace en un lote junto con la caja. Cada venta y cada movimiento de
//    efectivo pertenece al turno de quien lo registra, y es inmutable.
//    Descuentos, cambios de precio y devoluciones necesitan una autorización
//    escrita por un admin (con su propia sesión) para ese turno.
//  - accesos/{código} publica solo el número de versión de cuenta de un código
//    (lo necesita la pantalla de entrada tras restablecer un NIP).
// ---------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ----- Identidad ---------------------------------------------------
    // Debe coincidir con DOMINIO_CODIGOS en js/identidad.js.
    function dominioCodigos() {
      return 'codigo.aguilapos.firebaseapp.com';
    }
    function autenticado() {
      return request.auth != null && request.auth.token.email is string;
    }
    function emailActual() {
      return request.auth.token.email.lower();
    }
    // Código de empleado (sin versión) si el correo es sintético; si no, el
    // correo. Una sola expresión regular (el dominio repite dominioCodigos()):
    // las reglas tienen un tope de expresiones por petición.
    function usuarioActual() {
      return emailActual().replace('^([0-9]{6})([.][0-9]+)?@codigo[.]aguilapos[.]firebaseapp[.]com$', '$1');
    }
    function rutaPersonal() {
      return /databases/$(database)/documents/staff/$(usuarioActual());
    }
    function fichaActual() {
      return get(rutaPersonal()).data;
    }
    // Personal registrado y activo, con la cuenta vigente (correoAuth). Las
    // fichas anteriores a Gestión no tienen correoAuth: vale el correo mismo.
    function esPersonal() {
      let ruta = rutaPersonal();
      return autenticado() && exists(ruta) && fichaVigente(get(ruta).data);
    }
    function fichaVigente(ficha) {
      let f = ficha;
      let email = emailActual();
      return f.activo == true && f.get('correoAuth', email) == email;
    }
    function esAdmin() {
      return esPersonal() && fichaActual().rol == 'admin';
    }

    // ----- Validadores genéricos ----------------------------------------
    function esTexto(v, maximo) {
      return v is string && v.size() <= maximo;
    }
    function esTextoNoVacio(v, maximo) {
      return v is string && v.size() > 0 && v.size() <= maximo;
    }
    function esTextoONulo(v, maximo) {
      return v == null || esTexto(v, maximo);
    }
    function esEnteroONulo(v) {
      return v == null || v is int;
    }
    function esFechaISO(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    // Exactamente estos campos: ni uno más ni uno menos.
    // Nota de costo: en las reglas, un argumento se vuelve a evaluar cada vez
    // que se usa y un `let` solo una vez; por eso se fijan con let.
    function exactamente(d, campos) {
      let lista = campos;
      let claves = d.keys();
      return claves.hasOnly(lista) && claves.size() == lista.size();
    }

    // ----- products ------------------------------------------------------
    function camposProducto() {
      return [
        'upc', 'plu', 'nombre', 'marca', 'descriptor', 'presentacion',
        'precioCentavos', 'unidadVenta', 'precioPorKgCentavos', 'claseFiscal',
        'tiendas', 'existencias', 'costoCentavos', 'proveedor', 'activo',
        'ultimoPrecioImpresoCentavos', 'fechaUltimaImpresion', 'tokensBusqueda',
        'creadoEn', 'actualizadoEn', 'actualizadoPor'
      ];
    }

    function productoValido(d) {
      return exactamente(d, camposProducto())
        // UPC-A de 12 dígitos o EAN-13 de 13 (un EAN-13 que empieza por 0 se guarda como UPC-A de 12)
        && (d.upc == null || (d.upc is string && d.upc.matches('^([0-9]{12}|[1-9][0-9]{12})$')))
        && (d.plu == null || (d.plu is string && d.plu.matches('^[0-9]{4,5}$')))
        && esTextoNoVacio(d.nombre, 80)
        && esTextoONulo(d.marca, 60)
        && esTextoONulo(d.descriptor, 80)
        && esTexto(d.presentacion, 30)
        && d.precioCentavos is int
        && d.precioCentavos >= 0
        && d.precioCentavos <= 9999999
        && d.unidadVenta in ['pieza', 'peso']
        && (d.unidadVenta == 'pieza'
              ? (d.precioCentavos > 0 && d.precioPorKgCentavos == null)
              : (d.precioPorKgCentavos is int && d.precioPorKgCentavos > 0))
        && d.claseFiscal in ['gravado', 'tasaCero']
        && d.tiendas is list
        && d.tiendas.size() <= 20
        && esEnteroONulo(d.existencias)
        && esEnteroONulo(d.costoCentavos)
        && esTextoONulo(d.proveedor, 80)
        && d.activo is bool
        && (d.ultimoPrecioImpresoCentavos == null
              || (d.ultimoPrecioImpresoCentavos is int && d.ultimoPrecioImpresoCentavos >= 0))
        && (d.fechaUltimaImpresion == null || esFechaISO(d.fechaUltimaImpresion))
        && d.tokensBusqueda is list
        && d.tokensBusqueda.size() <= 400
        && d.creadoEn is timestamp
        && d.actualizadoEn is timestamp
        && d.actualizadoPor == usuarioActual();
    }

    // Id de la entrada de historial que debe acompañar a un cambio de precio:
    // "<productId>_<actualizadoEn en milisegundos>".
    function idHistorial(productId, d) {
      return productId + '_' + string(d.actualizadoEn.toMillis());
    }

    // Lo que el personal con permiso de catálogo puede cambiar de un producto.
    // Nunca precioCentavos, precioPorKgCentavos, unidadVenta, claseFiscal ni
    // activo: el precio lo pone y lo cambia un admin, y una baja se pide.
    function camposEditablesCatalogo() {
      return ['upc', 'plu', 'nombre', 'marca', 'descriptor', 'presentacion', 'tiendas', 'proveedor',
              'tokensBusqueda', 'ultimoPrecioImpresoCentavos', 'fechaUltimaImpresion',
              'actualizadoEn', 'actualizadoPor'];
    }
    // Una sola función con let (ver la nota de costo del POS, más abajo).
    function actualizarProducto(productId) {
      let email = emailActual();
      let yo = usuarioActual();
      let ficha = fichaDe(yo);
      let antes = resource.data;
      let d = request.resource.data;
      return vigente(ficha, email)
        && productoValido(d)
        && d.creadoEn == antes.creadoEn
        && d.existencias == antes.existencias
        && d.costoCentavos == antes.costoCentavos
        && (ficha.rol == 'admin'
              ? (d.precioCentavos == antes.precioCentavos
                 || existsAfter(/databases/$(database)/documents/priceHistory/$(idHistorial(productId, d))))
              : (ficha.get('catalogo', false) == true
                 && antes.activo == true
                 && d.diff(antes).affectedKeys().hasOnly(camposEditablesCatalogo())
                 // al imprimir etiquetas solo se anota el precio vigente
                 && (d.ultimoPrecioImpresoCentavos == antes.ultimoPrecioImpresoCentavos
                     || d.ultimoPrecioImpresoCentavos == antes.precioCentavos)));
    }

    match /products/{productId} {
      allow read: if esPersonal();

      // Los productos nuevos los crea un admin: en el back office, o al aprobar
      // la solicitud de alta de alguien del Catálogo (con el precio que él pone).
      allow create: if esAdmin()
        && productoValido(request.resource.data)
        && request.resource.data.creadoEn == request.resource.data.actualizadoEn
        // existencias y costo los administra el POS: el catálogo los deja en null
        && request.resource.data.existencias == null
        && request.resource.data.costoCentavos == null;

      allow update: if actualizarProducto(productId);

      // Los productos se desactivan (activo = false); nunca se borran.
      allow delete: if false;
    }

    // ----- priceHistory --------------------------------------------------
    function camposHistorial() {
      return ['productId', 'precioAnteriorCentavos', 'precioNuevoCentavos', 'fecha', 'usuario'];
    }
    function rutaProducto(productId) {
      return /databases/$(database)/documents/products/$(productId);
    }
    function entradaHistorialValida(d, entradaId) {
      return exactamente(d, camposHistorial())
        && d.productId is string
        && d.productId.size() > 0
        && d.fecha is timestamp
        && entradaId == d.productId + '_' + string(d.fecha.toMillis())
        && d.usuario == usuarioActual()
        && d.precioAnteriorCentavos is int
        && d.precioNuevoCentavos is int
        && d.precioAnteriorCentavos != d.precioNuevoCentavos
        // El precio anterior es el que está guardado antes de este lote,
        // y el nuevo el que queda después: el producto cambia en el mismo lote.
        && d.precioAnteriorCentavos == get(rutaProducto(d.productId)).data.precioCentavos
        && d.precioNuevoCentavos == getAfter(rutaProducto(d.productId)).data.precioCentavos
        && getAfter(rutaProducto(d.productId)).data.actualizadoEn == d.fecha;
    }

    match /priceHistory/{entradaId} {
      allow read: if esPersonal();
      // Solo el admin cambia precios, así que solo él escribe historial.
      allow create: if esAdmin() && entradaHistorialValida(request.resource.data, entradaId);
      allow update, delete: if false;
    }

    // ----- staff ---------------------------------------------------------
    // staff/{usuario}: usuario = código de empleado o correo real en minúsculas.
    function camposPersonal() {
      return ['usuario', 'tipo', 'correoAuth', 'nombre', 'rol', 'activo', 'tienda',
              'creadoEn', 'actualizadoEn', 'actualizadoPor', 'cuentaVersion'];
    }
    // correo (el real de la persona) y catalogo (permiso para la app Catálogo)
    // llegaron después: se aceptan fichas con o sin ellos.
    function camposPersonalOpcionales() {
      return ['correo', 'catalogo'];
    }
    function regexCorreo() {
      return '^[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}$';
    }
    // Correo sintético que corresponde a un código y una versión de cuenta.
    function correoDeCodigo(codigo, version) {
      return codigo + (version == 1 ? '' : '.' + string(version)) + '@' + dominioCodigos();
    }
    function personalValido(d, usuario) {
      let base = camposPersonal();
      let claves = d.keys();
      return claves.hasAll(base)
        && claves.hasOnly(base.concat(camposPersonalOpcionales()))
        && d.usuario == usuario
        && d.tipo in ['codigo', 'correo']
        && d.correoAuth is string
        && d.cuentaVersion is int
        && d.cuentaVersion >= 1
        && (d.tipo == 'codigo'
              ? (usuario.matches('^[0-9]{6}$')
                 && d.correoAuth == correoDeCodigo(usuario, d.cuentaVersion))
              : (usuario == usuario.lower()
                 && usuario.matches(regexCorreo())
                 && usuario.split('@')[1] != dominioCodigos()
                 && d.correoAuth == usuario
                 && d.cuentaVersion == 1))
        && esTextoNoVacio(d.nombre, 80)
        && d.rol in ['admin', 'empleado']
        && d.activo is bool
        && (d.tienda == null || (d.tienda is string && d.tienda.matches('^[a-z0-9-]{2,40}$')))
        && d.creadoEn is timestamp
        && d.actualizadoEn is timestamp
        && d.actualizadoPor == usuarioActual()
        && correoPersonalValido(d.get('correo', null), d)
        && d.get('catalogo', false) is bool;
    }
    function correoPersonalValido(correo, d) {
      return correo == null
        || (correo is string
            && correo == correo.lower()
            && correo.matches(regexCorreo())
            && correo.split('@')[1] != dominioCodigos()
            && (d.tipo != 'correo' || correo == d.usuario));
    }

    match /staff/{usuario} {
      // Cada quien puede leer su propia ficha (para saber por qué no entra);
      // el personal activo puede leer todas (nombres en el historial).
      allow read: if esPersonal() || (autenticado() && usuarioActual() == usuario);

      allow create: if esAdmin()
        && personalValido(request.resource.data, usuario)
        && request.resource.data.creadoEn == request.resource.data.actualizadoEn;

      // Las fichas anteriores a Gestión (solo nombre, rol, activo) se completan
      // al primer cambio: por eso los campos de referencia usan get() con defecto.
      // Un admin no puede desactivarse, degradarse ni cambiar su propia cuenta.
      allow update: if esAdmin()
        && personalValido(request.resource.data, usuario)
        && request.resource.data.creadoEn == resource.data.get('creadoEn', request.resource.data.creadoEn)
        && request.resource.data.tipo == resource.data.get('tipo', request.resource.data.tipo)
        && request.resource.data.cuentaVersion >= resource.data.get('cuentaVersion', 1)
        && (usuario != usuarioActual()
            || (request.resource.data.activo == true
                && request.resource.data.rol == 'admin'
                && request.resource.data.correoAuth == emailActual()));

      allow delete: if false;
    }

    // ----- accesos -------------------------------------------------------
    // accesos/{código} = { version }: qué versión de cuenta tiene hoy un código,
    // para que la pantalla de entrada sepa a qué correo sintético entrar tras un
    // restablecimiento de NIP. Lectura pública de UN documento (sin listar) y
    // solo el número de versión; se escribe en el mismo lote que la ficha.
    match /accesos/{codigo} {
      allow get: if true;
      allow list: if false;
      allow create, update: if esAdmin()
        && codigo.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['version'])
        && request.resource.data.version is int
        && request.resource.data.version >= 1
        && request.resource.data.version == getAfter(/databases/$(database)/documents/staff/$(codigo)).data.cuentaVersion;
      allow delete: if false;
    }

    // ----- correos -------------------------------------------------------
    // correos/{correo} = { codigo }: de qué colaborador es un correo, para
    // entrar con correo + NIP. Lectura pública de UN documento (sin listar);
    // lo escribe un admin en el mismo lote que la ficha que lleva ese correo.
    match /correos/{correo} {
      allow get: if true;
      allow list: if esAdmin();
      allow create: if esAdmin()
        && correo == correo.lower()
        && correo.matches(regexCorreo())
        && request.resource.data.keys().hasOnly(['codigo'])
        && request.resource.data.codigo is string
        && request.resource.data.codigo.matches('^[0-9]{6}$')
        && getAfter(/databases/$(database)/documents/staff/$(request.resource.data.codigo)).data.correo == correo;
      allow update: if false;
      allow delete: if esAdmin();
    }

    // ----- nips ------------------------------------------------------------
    // nips/{huella} = { codigo, version }: de quién es un NIP, para entrar en
    // la caja solo con el NIP. La huella es HMAC-SHA-256(clave de caja, NIP):
    // sin la clave no se puede calcular, así que leer un documento suelto es
    // público y listar no. Crear falla si la huella ya existe: un NIP no se
    // repite. Se escribe en el mismo lote que la ficha (misma versión).
    match /nips/{huella} {
      allow get: if true;
      allow list: if esAdmin();
      allow create: if esAdmin()
        && huella.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['codigo', 'version'])
        && request.resource.data.codigo is string
        && request.resource.data.codigo.matches('^[0-9]{6}$')
        && request.resource.data.version is int
        && nipDeFicha(getAfter(/databases/$(database)/documents/staff/$(request.resource.data.codigo)).data, request.resource.data.version);
      allow update: if false;
      allow delete: if esAdmin();
    }
    function nipDeFicha(ficha, version) {
      let f = ficha;
      return f.tipo == 'codigo' && f.cuentaVersion == version;
    }

    // ----- secretos ----------------------------------------------------------
    // secretos/caja = { clave, creadaEn, creadaPor }: la clave de las huellas
    // de NIP. Solo la leen los administradores (y la guarda cada caja que un
    // administrador configura). Se crea una vez y no cambia.
    match /secretos/{id} {
      allow get: if esAdmin();
      allow list: if false;
      allow create: if esAdmin()
        && id == 'caja'
        && exactamente(request.resource.data, ['clave', 'creadaEn', 'creadaPor'])
        && request.resource.data.clave is string
        && request.resource.data.clave.size() >= 40
        && request.resource.data.clave.size() <= 100
        && request.resource.data.creadaEn == request.time
        && request.resource.data.creadaPor == usuarioActual();
      allow update, delete: if false;
    }

    // ----- solicitudes -----------------------------------------------------
    // Lo que el personal del Catálogo pide al administrador:
    //  - alta: un producto nuevo SIN precio (producto = la propuesta). El
    //    admin pone precio y clase fiscal, crea el producto y aprueba la
    //    solicitud en el mismo lote (productoId = el producto creado).
    //  - baja: quitar un producto activo del catálogo. El admin lo desactiva
    //    y aprueba en el mismo lote, o rechaza.
    // Nadie las borra; solo un admin las resuelve, una vez.
    function camposSolicitud() {
      return ['tipo', 'estado', 'producto', 'productoId', 'productoNombre', 'motivo',
              'creadaPor', 'creadaPorNombre', 'creadaEn', 'resueltaPor', 'resueltaEn', 'nota'];
    }
    function camposPropuesta() {
      return ['upc', 'plu', 'nombre', 'marca', 'descriptor', 'presentacion', 'unidadVenta', 'tiendas', 'proveedor'];
    }
    function propuestaValida(propuesta) {
      let p = propuesta;
      return p is map
        && exactamente(p, camposPropuesta())
        && (p.upc == null || (p.upc is string && p.upc.matches('^([0-9]{12}|[1-9][0-9]{12})$')))
        && (p.plu == null || (p.plu is string && p.plu.matches('^[0-9]{4,5}$')))
        && esTextoNoVacio(p.nombre, 80)
        && esTextoONulo(p.marca, 60)
        && esTextoONulo(p.descriptor, 80)
        && esTexto(p.presentacion, 30)
        && p.unidadVenta in ['pieza', 'peso']
        && p.tiendas is list
        && p.tiendas.size() <= 20
        && esTextoONulo(p.proveedor, 80);
    }
    function puedeCatalogo(ficha, email) {
      let f = ficha;
      return vigente(f, email) && (f.rol == 'admin' || f.get('catalogo', false) == true);
    }
    function crearSolicitud(datos) {
      let d = datos;
      let email = emailActual();
      let yo = usuarioActual();
      return puedeCatalogo(fichaDe(yo), email)
        && exactamente(d, camposSolicitud())
        && d.estado == 'pendiente'
        && d.creadaPor == yo
        && esTextoNoVacio(d.creadaPorNombre, 80)
        && d.creadaEn == request.time
        && d.resueltaPor == null && d.resueltaEn == null && d.nota == null
        && esTexto(d.motivo, 300)
        && esTextoNoVacio(d.productoNombre, 120)
        && (d.tipo == 'alta'
              ? (d.productoId == null && propuestaValida(d.producto))
              : (d.tipo == 'baja'
                 && d.producto == null
                 && d.productoId is string
                 && get(/databases/$(database)/documents/products/$(d.productoId)).data.activo == true));
    }
    function resolverSolicitud() {
      let email = emailActual();
      let yo = usuarioActual();
      let ficha = fichaDe(yo);
      let antes = resource.data;
      let d = request.resource.data;
      return vigente(ficha, email)
        && ficha.rol == 'admin'
        && antes.estado == 'pendiente'
        && d.diff(antes).affectedKeys().hasOnly(['estado', 'productoId', 'resueltaPor', 'resueltaEn', 'nota'])
        && d.estado in ['aprobada', 'rechazada']
        && d.resueltaPor == yo
        && d.resueltaEn == request.time
        && esTextoONulo(d.nota, 300)
        && (d.estado == 'rechazada'
              ? d.productoId == antes.productoId
              // alta: el producto existe al terminar el lote (lo creó el admin con
              // su precio, o ya existía y la solicitud se enlaza con él)
              : (antes.tipo == 'alta'
                 ? (d.productoId is string
                    && existsAfter(/databases/$(database)/documents/products/$(d.productoId)))
                 // baja: el producto queda desactivado en el mismo lote
                 : (d.productoId == antes.productoId
                    && getAfter(/databases/$(database)/documents/products/$(d.productoId)).data.activo == false)));
    }

    match /solicitudes/{solicitudId} {
      allow read: if puedeCatalogo(fichaDe(usuarioActual()), emailActual());
      allow create: if crearSolicitud(request.resource.data);
      allow update: if resolverSolicitud();
      allow delete: if false;
    }

    // ----- stores --------------------------------------------------------
    // Los datos del encabezado del recibo (teléfono, correo, número de HST)
    // son opcionales: las tiendas anteriores al POS no los tienen.
    function tiendaValida(d) {
      return d.keys().hasAll(['nombre', 'direccion', 'activo'])
        && d.keys().hasOnly(['nombre', 'direccion', 'activo', 'telefono', 'correo', 'numeroImpuesto'])
        && esTextoNoVacio(d.nombre, 80)
        && esTexto(d.direccion, 160)
        && d.activo is bool
        && esTexto(d.get('telefono', ''), 30)
        && esTexto(d.get('correo', ''), 80)
        && esTexto(d.get('numeroImpuesto', ''), 30);
    }

    match /stores/{storeId} {
      allow read: if esPersonal();
      allow create, update: if esAdmin()
        && tiendaValida(request.resource.data)
        && storeId.matches('^[a-z0-9-]{2,40}$');
      allow delete: if false;
    }

    // =====================================================================
    // POS · caja registradora
    // =====================================================================
    // Firestore corta la evaluación de una petición tras un número fijo de
    // expresiones, y en las reglas un argumento de función se vuelve a evaluar
    // cada vez que se usa (un `let`, solo una vez). Por eso cada regla del POS
    // es una sola función que fija con `let` quién escribe, su ficha y el
    // documento, y comprueba lo que protege el dinero y el acceso.
    // pruebas/reglas/holgura.test.mjs mide el margen que queda en cada una.
    function fichaDe(usuario) {
      return get(/databases/$(database)/documents/staff/$(usuario)).data;
    }
    function vigente(ficha, email) {
      let f = ficha;
      let e = email;
      return f.activo == true && f.get('correoAuth', e) == e;
    }
    // Hora del equipo: puede ir algo adelantada, nunca en el futuro lejano.
    function noEnElFuturo(marca) {
      let t = marca;
      return t is timestamp && t <= request.time + duration.value(5, 'm');
    }
    function rutaTurno(turnoId) {
      return /databases/$(database)/documents/turnos/$(turnoId);
    }
    function rutaCaja(cajaId) {
      return /databases/$(database)/documents/cajas/$(cajaId);
    }
    // Ventas, turnos, movimientos y autorizaciones: cada quien lo suyo; el admin, todo.
    function puedeLeerDe(cajero) {
      let email = emailActual();
      let yo = usuarioActual();
      let ficha = fichaDe(yo);
      return vigente(ficha, email) && (ficha.rol == 'admin' || cajero == yo);
    }

    // ----- config/pos: impuesto, recibo, teclas de departamento ------------
    function camposConfigPos() {
      return ['impuestoNombre', 'tasaImpuestoBP', 'fondoSugeridoCentavos', 'limiteVentaLibreCentavos',
              'conteoCiego', 'papelRecibo', 'reciboPie', 'departamentos', 'actualizadoEn', 'actualizadoPor'];
    }
    function configPosValida(d) {
      return exactamente(d, camposConfigPos())
        && esTextoNoVacio(d.impuestoNombre, 20)
        && d.tasaImpuestoBP is int && d.tasaImpuestoBP >= 0 && d.tasaImpuestoBP <= 3000
        && d.fondoSugeridoCentavos is int && d.fondoSugeridoCentavos >= 0
        && d.limiteVentaLibreCentavos is int && d.limiteVentaLibreCentavos >= 0
        && d.conteoCiego is bool
        && d.papelRecibo in [58, 80]
        && esTexto(d.reciboPie, 300)
        && d.departamentos is list
        && d.departamentos.size() <= 24
        && d.actualizadoEn is timestamp
        && d.actualizadoPor == usuarioActual();
    }

    match /config/{documento} {
      allow read: if esPersonal();
      allow create, update: if esAdmin() && documento == 'pos' && configPosValida(request.resource.data);
      allow delete: if false;
    }

    // ----- cajas ------------------------------------------------------------
    // cajas/{id}: el admin la da de alta y la edita; quien abre o cierra turno
    // solo toca los campos del turno, en el mismo lote que turnos/{id}.
    function camposCaja() {
      return ['nombre', 'numero', 'tienda', 'activo',
              'turnoActual', 'turnoCajero', 'turnoCajeroNombre', 'turnoDesde',
              'actualizadoEn', 'actualizadoPor'];
    }
    function cajaConfigValida(d) {
      return esTextoNoVacio(d.nombre, 40)
        && d.numero is int && d.numero >= 1 && d.numero <= 99
        && d.tienda.matches('^[a-z0-9-]{2,40}$')
        && d.activo is bool
        && d.actualizadoEn is timestamp;
    }
    function actualizarCaja(cajaId) {
      let email = emailActual();
      let yo = usuarioActual();
      let ficha = fichaDe(yo);
      let antes = resource.data;
      let d = request.resource.data;
      let cambios = d.diff(antes).affectedKeys();
      return vigente(ficha, email)
        && exactamente(d, camposCaja())
        && ((ficha.rol == 'admin'
              && cambios.hasOnly(['nombre', 'numero', 'tienda', 'activo', 'actualizadoEn', 'actualizadoPor'])
              && cajaConfigValida(d)
              && d.actualizadoPor == yo)
            || (cambios.hasOnly(['turnoActual', 'turnoCajero', 'turnoCajeroNombre', 'turnoDesde'])
                && (abreTurnoEnCaja(cajaId, antes, d, yo) || cierraTurnoEnCaja(antes, d, yo, ficha))));
    }
    // Abrir turno: la caja activa estaba libre y queda con un turno propio,
    // abierto en este mismo lote.
    function abreTurnoEnCaja(cajaId, antes, d, yo) {
      return antes.turnoActual == null
        && antes.activo == true
        && d.turnoActual is string
        && d.turnoCajero == yo
        && d.turnoCajeroNombre is string
        && turnoRecienAbierto(cajaId, d, yo);
    }
    function turnoRecienAbierto(cajaId, d, yo) {
      let turno = getAfter(rutaTurno(d.turnoActual)).data;
      return turno.cajero == yo && turno.caja == cajaId && turno.estado == 'abierto' && d.turnoDesde == turno.abiertoEn;
    }
    // Cerrar turno: la caja queda libre y su turno, cerrado en este mismo lote
    // por quien lo abrió o por un admin.
    function cierraTurnoEnCaja(antes, d, yo, ficha) {
      return antes.turnoActual is string
        && d.turnoActual == null && d.turnoCajero == null && d.turnoCajeroNombre == null && d.turnoDesde == null
        && turnoRecienCerrado(antes.turnoActual, yo, ficha);
    }
    function turnoRecienCerrado(turnoId, yo, ficha) {
      let turno = getAfter(rutaTurno(turnoId)).data;
      return turno.estado == 'cerrado' && (turno.cajero == yo || ficha.rol == 'admin');
    }

    match /cajas/{cajaId} {
      allow read: if esPersonal();
      allow create: if esAdmin()
        && exactamente(request.resource.data, camposCaja())
        && cajaConfigValida(request.resource.data)
        && request.resource.data.turnoActual == null
        && request.resource.data.turnoCajero == null
        && request.resource.data.actualizadoPor == usuarioActual();
      allow update: if actualizarCaja(cajaId);
      allow delete: if false;
    }

    // ----- turnos -----------------------------------------------------------
    // La apertura usa la hora del servidor (las horas trabajadas no dependen
    // del reloj del equipo). El cierre puede registrarse sin conexión: lleva
    // la hora del equipo (cerradoEn) y la del servidor al sincronizar.
    function camposTurno() {
      return ['caja', 'cajaNombre', 'numeroCaja', 'tienda', 'tiendaNombre', 'cajero', 'cajeroNombre',
              'estado', 'abiertoEn', 'fondoInicialCentavos',
              'cerradoEn', 'cerradoPor', 'cierreRegistradoEn', 'cierreForzado',
              'efectivoContadoCentavos', 'conteo', 'diferenciaCentavos', 'resumen', 'notaCierre'];
    }
    function camposCierreTurno() {
      return ['estado', 'cerradoEn', 'cerradoPor', 'cierreRegistradoEn', 'cierreForzado',
              'efectivoContadoCentavos', 'conteo', 'diferenciaCentavos', 'resumen', 'notaCierre'];
    }
    function abrirTurno(datos, turnoId) {
      let d = datos;
      let email = emailActual();
      let yo = usuarioActual();
      let caja = get(rutaCaja(d.caja)).data;
      return vigente(fichaDe(yo), email)
        && exactamente(d, camposTurno())
        && d.cajero == yo
        && d.estado == 'abierto'
        && d.abiertoEn == request.time
        && d.fondoInicialCentavos is int && d.fondoInicialCentavos >= 0
        && d.cerradoEn == null && d.cierreForzado == false && d.resumen == null
        && caja.activo == true
        && caja.turnoActual == null
        && caja.tienda == d.tienda
        && caja.numero == d.numeroCaja
        && getAfter(rutaCaja(d.caja)).data.turnoActual == turnoId;
    }
    function cerrarTurno(turnoId) {
      let email = emailActual();
      let yo = usuarioActual();
      let ficha = fichaDe(yo);
      let antes = resource.data;
      let d = request.resource.data;
      return vigente(ficha, email)
        && antes.estado == 'abierto'
        && (antes.cajero == yo || ficha.rol == 'admin')
        && d.diff(antes).affectedKeys().hasOnly(camposCierreTurno())
        && d.estado == 'cerrado'
        && d.cerradoPor == yo
        && d.cierreForzado == (yo != antes.cajero)
        && d.cierreRegistradoEn == request.time
        && noEnElFuturo(d.cerradoEn)
        && d.cerradoEn >= antes.abiertoEn
        && (d.efectivoContadoCentavos == null || d.efectivoContadoCentavos is int)
        && d.resumen is map
        && getAfter(rutaCaja(antes.caja)).data.turnoActual != turnoId;
    }

    match /turnos/{turnoId} {
      allow read: if puedeLeerDe(resource.data.cajero);
      allow create: if abrirTurno(request.resource.data, turnoId);
      allow update: if cerrarTurno(turnoId);
      allow delete: if false;
    }

    // ----- ventas -----------------------------------------------------------
    // Inmutables. Las reglas no pueden recorrer las líneas: comprueban los
    // campos, que los totales cuadren entre sí y con los pagos, la hora del
    // servidor y que la venta sea del turno de quien la registra. Cada línea
    // la valida la app (js/ticket.js, validarVenta) antes de guardar.
    // Descuentos, cambios de precio y devoluciones necesitan una autorización
    // de un admin para ese turno (salvo que quien vende sea admin).
    function camposVenta() {
      return ['folio', 'numero', 'dia', 'tipo',
              'turno', 'caja', 'cajaNombre', 'numeroCaja', 'tienda', 'tiendaNombre', 'cajero', 'cajeroNombre',
              'fecha', 'registradoEn', 'lineas', 'articulos',
              'brutoCentavos', 'descuentoLineasCentavos', 'subtotalCentavos', 'descuentoTicketCentavos',
              'baseGravadaCentavos', 'baseTasaCeroCentavos', 'tasaImpuestoBP', 'impuestoCentavos', 'totalCentavos',
              'redondeoCentavos', 'cambioCentavos', 'pagos', 'porMetodo',
              'lineasAnuladas', 'lineasAnuladasCentavos', 'cambiosPrecio',
              'autorizacion', 'autorizadoPor', 'ventaOriginal'];
    }
    function totalesCuadran(datos) {
      let d = datos;
      let m = d.porMetodo;
      return d.tipo in ['venta', 'devolucion']
        && d.lineas.size() > 0 && d.lineas.size() <= 300
        && d.pagos.size() <= 10
        // centavos enteros, nunca flotantes
        && d.brutoCentavos is int && d.subtotalCentavos is int && d.totalCentavos is int
        && d.impuestoCentavos is int && d.baseGravadaCentavos is int && d.baseTasaCeroCentavos is int
        && d.descuentoLineasCentavos is int && d.descuentoTicketCentavos is int && d.redondeoCentavos is int
        && m.efectivo is int && m.debito is int && m.credito is int && m.otro is int
        && d.subtotalCentavos == d.brutoCentavos - d.descuentoLineasCentavos
        && d.totalCentavos == d.subtotalCentavos - d.descuentoTicketCentavos + d.impuestoCentavos
        && d.baseGravadaCentavos + d.baseTasaCeroCentavos == d.subtotalCentavos - d.descuentoTicketCentavos
        && d.redondeoCentavos >= -2 && d.redondeoCentavos <= 2
        && m.size() == 4
        && m.efectivo + m.debito + m.credito + m.otro == d.totalCentavos + d.redondeoCentavos
        && d.descuentoLineasCentavos >= 0 && d.descuentoTicketCentavos >= 0
        && (d.tipo == 'venta' ? d.totalCentavos >= 0 : d.totalCentavos < 0);
    }
    function necesitaAutorizacion(datos) {
      let d = datos;
      return d.tipo == 'devolucion' || d.descuentoLineasCentavos > 0 || d.descuentoTicketCentavos > 0 || d.cambiosPrecio > 0;
    }
    function autorizacionCoincide(d, yo) {
      let a = get(/databases/$(database)/documents/autorizaciones/$(d.autorizacion)).data;
      return a.cajero == yo
        && a.turno == d.turno
        && a.admin == d.autorizadoPor
        && a.tipo == (d.tipo == 'devolucion' ? 'devolucion' : 'modificacion');
    }
    function crearVenta(datos) {
      let d = datos;
      let email = emailActual();
      let yo = usuarioActual();
      let ficha = fichaDe(yo);
      let turno = get(rutaTurno(d.turno)).data;
      return vigente(ficha, email)
        && exactamente(d, camposVenta())
        && d.cajero == yo
        && d.registradoEn == request.time
        && noEnElFuturo(d.fecha)
        && totalesCuadran(d)
        && turno.cajero == yo
        && turno.caja == d.caja
        && turno.tienda == d.tienda
        && turno.numeroCaja == d.numeroCaja
        && d.fecha >= turno.abiertoEn - duration.value(5, 'm')
        && (!necesitaAutorizacion(d) || ficha.rol == 'admin' || autorizacionCoincide(d, yo));
    }

    match /ventas/{ventaId} {
      allow read: if puedeLeerDe(resource.data.cajero);
      allow create: if crearVenta(request.resource.data);
      allow update, delete: if false;
    }

    // ----- movimientos de efectivo -----------------------------------------
    // Retiros (a la caja fuerte), entradas de cambio, pagos desde caja,
    // aperturas de cajón sin venta y tickets cancelados. Inmutables.
    function camposMovimiento() {
      return ['turno', 'caja', 'tienda', 'cajero', 'cajeroNombre', 'tipo', 'importeCentavos', 'motivo', 'fecha', 'registradoEn'];
    }
    function crearMovimiento(datos) {
      let d = datos;
      let email = emailActual();
      let yo = usuarioActual();
      let turno = get(rutaTurno(d.turno)).data;
      return vigente(fichaDe(yo), email)
        && exactamente(d, camposMovimiento())
        && d.cajero == yo
        && d.tipo in ['retiro', 'entrada', 'pago', 'apertura', 'cancelacion']
        && d.importeCentavos is int
        && (d.tipo == 'apertura' ? d.importeCentavos == 0 : (d.importeCentavos > 0 || d.tipo == 'cancelacion'))
        && d.importeCentavos >= 0
        && noEnElFuturo(d.fecha)
        && d.registradoEn == request.time
        && turno.cajero == yo
        && turno.caja == d.caja
        && turno.tienda == d.tienda;
    }

    match /movimientosCaja/{movimientoId} {
      allow read: if puedeLeerDe(resource.data.cajero);
      allow create: if crearMovimiento(request.resource.data);
      allow update, delete: if false;
    }

    // ----- autorizaciones ---------------------------------------------------
    // Las escribe un admin desde la caja con su propio código y NIP (sesión
    // aparte): autoriza descuentos y cambios de precio (modificacion) o una
    // devolución para el turno abierto de una cajera.
    function camposAutorizacion() {
      return ['tipo', 'turno', 'caja', 'cajero', 'admin', 'fecha', 'detalle'];
    }
    function crearAutorizacion(datos) {
      let d = datos;
      let email = emailActual();
      let yo = usuarioActual();
      let ficha = fichaDe(yo);
      let turno = get(rutaTurno(d.turno)).data;
      return vigente(ficha, email)
        && ficha.rol == 'admin'
        && exactamente(d, camposAutorizacion())
        && d.tipo in ['modificacion', 'devolucion']
        && d.admin == yo
        && d.fecha == request.time
        && esTexto(d.detalle, 200)
        && turno.cajero == d.cajero
        && turno.caja == d.caja
        && turno.estado == 'abierto';
    }

    match /autorizaciones/{autorizacionId} {
      allow read: if puedeLeerDe(resource.data.cajero);
      allow create: if crearAutorizacion(request.resource.data);
      allow update, delete: if false;
    }

    // ----- eventos: movimientos en vivo de las cajas -------------------------
    // Cada acción de la caja (venta iniciada, artículo, pago, venta completada,
    // cancelación, efectivo, turno…). Informativos: lo que cuenta para el dinero
    // son ventas, turnos y movimientos de caja. Inmutables.
    function camposEvento() {
      return ['tipo', 'turno', 'caja', 'cajaNombre', 'numeroCaja', 'tienda', 'cajero', 'cajeroNombre',
              'ticket', 'folio', 'texto', 'importeCentavos', 'fecha', 'registradoEn'];
    }
    function tiposEvento() {
      return ['venta_iniciada', 'articulo', 'cantidad', 'precio', 'descuento', 'articulo_anulado',
              'autorizacion', 'espera', 'recuperada', 'venta_cancelada', 'pago', 'venta_completada',
              'devolucion_iniciada', 'devolucion_completada', 'efectivo', 'turno_abierto', 'turno_cerrado'];
    }
    function crearEvento(datos) {
      let d = datos;
      let email = emailActual();
      let yo = usuarioActual();
      return vigente(fichaDe(yo), email)
        && exactamente(d, camposEvento())
        && d.cajero == yo
        && d.tipo in tiposEvento()
        && esTextoNoVacio(d.turno, 60)
        && esTextoNoVacio(d.caja, 60)
        && esTexto(d.cajaNombre, 40)
        && d.numeroCaja is int
        && esTexto(d.tienda, 40)
        && esTexto(d.cajeroNombre, 80)
        && esTextoONulo(d.ticket, 40)
        && esTextoONulo(d.folio, 20)
        && esTexto(d.texto, 200)
        && esEnteroONulo(d.importeCentavos)
        && noEnElFuturo(d.fecha)
        && d.registradoEn == request.time;
    }

    match /eventos/{eventoId} {
      allow read: if esAdmin();
      allow create: if crearEvento(request.resource.data);
      allow update, delete: if false;
    }

    // ----- recepciones: la mercancía que llegó --------------------------------
    // Una entrega por documento: tienda, proveedor, factura o remisión, nota y
    // las líneas { producto, nombre, upc, plu, cantidad, pesoGramos } (la app
    // las valida una por una; las reglas no recorren listas). No toca las
    // existencias de los productos. Un admin la puede anular (queda a la vista,
    // tachada, y no cuenta); nadie la borra.
    function camposRecepcion() {
      return ['tienda', 'proveedor', 'referencia', 'nota', 'lineas', 'productos', 'piezas', 'gramos',
              'recibidoPor', 'recibidoPorNombre', 'fecha', 'anulada', 'anuladaPor', 'anuladaEn'];
    }
    function crearRecepcion(datos) {
      let d = datos;
      let email = emailActual();
      let yo = usuarioActual();
      return puedeCatalogo(fichaDe(yo), email)
        && exactamente(d, camposRecepcion())
        && d.recibidoPor == yo
        && esTextoNoVacio(d.recibidoPorNombre, 80)
        && d.fecha == request.time
        && d.anulada == false && d.anuladaPor == null && d.anuladaEn == null
        && (d.tienda == null || (d.tienda is string && d.tienda.matches('^[a-z0-9-]{2,40}$')))
        && esTextoONulo(d.proveedor, 80)
        && esTextoONulo(d.referencia, 60)
        && esTextoONulo(d.nota, 200)
        && d.lineas is list
        && d.lineas.size() > 0
        && d.lineas.size() <= 300
        && d.productos == d.lineas.size()
        && d.piezas is int && d.piezas >= 0
        && d.gramos is int && d.gramos >= 0;
    }
    function anularRecepcion() {
      let email = emailActual();
      let yo = usuarioActual();
      let ficha = fichaDe(yo);
      let antes = resource.data;
      let d = request.resource.data;
      return vigente(ficha, email)
        && ficha.rol == 'admin'
        && antes.anulada == false
        && d.diff(antes).affectedKeys().hasOnly(['anulada', 'anuladaPor', 'anuladaEn'])
        && d.anulada == true
        && d.anuladaPor == yo
        && d.anuladaEn == request.time;
    }

    match /recepciones/{recepcionId} {
      allow read: if puedeCatalogo(fichaDe(usuarioActual()), emailActual());
      allow create: if crearRecepcion(request.resource.data);
      allow update: if anularRecepcion();
      allow delete: if false;
    }

    // ----- pantallas: la pantalla del cliente en una tableta --------------------
    // pantallas/{huella} = { caja, cajero, estado, actualizadoEn }: lo que ve el
    // cliente de esa caja (js/pantalla-cliente.js arma `estado`). La huella es
    // HMAC-SHA-256(clave de caja, "pantalla:" + caja): sin la clave nadie puede
    // dar con el documento, y se lee sin sesión solo por su id (sin listar).
    // Un admin la empareja (crea) y la desconecta (borra); la caja solo la
    // actualiza mientras exista, a nombre de quien atiende.
    function escribirPantalla(datos, soloAdmin) {
      let d = datos;
      let email = emailActual();
      let yo = usuarioActual();
      let ficha = fichaDe(yo);
      return vigente(ficha, email)
        && (!soloAdmin || ficha.rol == 'admin')
        && exactamente(d, ['caja', 'cajero', 'estado', 'actualizadoEn'])
        && d.cajero == yo
        && esTextoNoVacio(d.caja, 60)
        && d.estado is map
        && d.estado.size() <= 40
        && d.estado.v == 1
        && d.estado.fase in ['cerrada', 'libre', 'venta', 'cobro', 'cobrado']
        && d.actualizadoEn == request.time;
    }

    match /pantallas/{pantallaId} {
      allow get: if pantallaId.matches('^[0-9a-f]{64}$');
      allow list: if false;
      allow create: if pantallaId.matches('^[0-9a-f]{64}$') && escribirPantalla(request.resource.data, true);
      allow update: if escribirPantalla(request.resource.data, false);
      allow delete: if esAdmin();
    }
  }
}
